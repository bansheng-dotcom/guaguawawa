{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "report spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["extends", "role"],
  "properties": {
    "extends": {"enum": ["analyst", "decision", "delivery", "review", "design"]},
    "role": {"type": "string", "pattern": "^r[0-9]{2}$"},
    "title_prefix": {"type": "string", "maxLength": 12},
    "doc_type": {"type": "string", "maxLength": 20},
    "adapter": {"enum": ["r06", "r07"]},
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_chars": {"type": "integer", "minimum": 0},
              "min_tables": {"type": "integer", "minimum": 0},
              "enabled": {"type": "boolean"}
            }
          }
        },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retention_min": {"type": "number", "minimum": 0, "maximum": 1},
            "trace_min": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "dimensions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "min_obs"],
            "properties": {
              "id": {"type": "string"},
              "min_obs": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
