{
  "opening": {
    "statuses": ["Open", "Closed"],
    "required": ["job_title", "designation"]
  },
  "applicant": {
    "statuses": ["Open", "Replied", "Shortlisted", "Rejected", "Hold", "Accepted"],
    "required": ["applicant_name", "email_id"]
  },
  "offer": {
    "statuses": ["Draft", "Ready to Send", "Awaiting Response", "Accepted", "Rejected", "Cancelled"],
    "required": ["applicant_name", "applicant_email", "offer_date", "designation"],
    "accept_prior_statuses": ["Shortlisted", "Accepted"]
  },
  "employee": {
    "statuses": ["Active", "Inactive", "Suspended", "Left"],
    "required": ["first_name", "gender", "date_of_birth", "date_of_joining"],
    "salary_modes": ["Bank", "Cash", "Cheque"]
  },
  "contract": {
    "expiry_window_days": 30
  },
  "attendance": {
    "statuses": ["Present", "Absent", "On Leave", "Half Day", "Work From Home"],
    "required": ["employee", "attendance_date"]
  },
  "leave": {
    "statuses": ["Open", "Approved", "Rejected", "Cancelled"],
    "required": ["employee", "leave_type", "from_date", "to_date"],
    "half_day_value": 0.5
  },
  "appraisal": {
    "score_min": 0.0,
    "score_max": 5.0
  },
  "goal": {
    "statuses": ["Pending", "In Progress", "Completed", "Archived", "Closed"],
    "progress_min": 0.0,
    "progress_max": 100.0
  },
  "payroll": {
    "frequencies": ["Monthly", "Fortnightly", "Bimonthly", "Weekly", "Daily"],
    "component_types": ["Earning", "Deduction", "Employer Contribution"],
    "tolerance": 0.01
  },
  "expense": {
    "approval_statuses": ["Draft", "Approved", "Rejected", "Cancelled"],
    "statuses": ["Draft", "Paid", "Partially Paid", "Unpaid", "Rejected", "Submitted", "Cancelled"]
  },
  "report": {
    "metric_fields": ["headcount", "turnover_rate", "attendance_rate", "leave_balance", "payroll_input_count"]
  },
  "review": {
    "unauthorized_hr_words": ["直接招聘", "直接解雇", "直接辞退", "直接开除", "直接发薪", "代发工资", "打款", "立即入职", "单方解除"],
    "pii_words": ["身份证号", "银行卡号", "银行账号", "家庭住址", "家人信息", "体检报告", "宗教信仰", "民族", "户籍", "婚姻状况", "家属姓名"],
    "scope_terms": ["劳动仲裁", "竞业协议效力", "个税申报", "社保合规", "法律意见", "税务结论", "劳动合同效力"],
    "handoff_keys": ["handoff", "授权", "authorized", "移交", "交接", "approved_by", "复核"],
    "concrete_keys": ["opening", "applicant", "offer", "employee", "contract", "attendance", "leave", "appraisal", "goal", "payroll_input", "payroll_calc", "claim", "benefit", "headcount", "checks", "ok"],
    "conclusion_keys": ["summary", "note", "next", "description", "conclusion", "recommendation", "reason", "narrative", "insight"],
    "evidence_keys": ["opening_count", "applicant_count", "offer_count", "employee_count", "contract_count", "attendance_count", "leave_count", "appraisal_count", "goal_count", "payroll_input_count", "claim_count", "benefit_count", "headcount", "total_amount", "component_count"]
