{
  "_note": "蛙得名（PM / 产品规划）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r07",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "PM / 产品规划",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "prd_grade",
      "name": "PRD 门禁得分",
      "formula": "通过门禁数 / 总门禁数 × 100",
      "unit": "分",
      "target": "≥ 80",
      "alert": "< 60 禁止进开发"
    },
    {
      "id": "jump_loss",
      "name": "主流程跳失率增幅",
      "formula": "上线后跳失率 − 上线前跳失率",
      "unit": "%",
      "target": "≤ 2%",
      "alert": "> 5% 停止扩量"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "PRD 缺验收判据",
      "verdict": "BLOCKER",
      "action": "退回补验收标准"
    },
    {
      "id": "G2",
      "when": "北极星指标无法定义",
      "verdict": "BLOCKER",
      "action": "退回定义指标"
    },
    {
      "id": "G3",
      "when": "需求变更 > 3 次",
      "verdict": "WARN",
      "action": "冻结迭代"
    }
  ],
  "guardrails": [
    {
      "dim": "PRD 门禁得分",
      "metric": "PRD 门禁得分",
      "base": "≥ 80",
      "threshold": "< 60 禁止进开发"
    },
    {
      "dim": "主流程跳失率增幅",
      "metric": "主流程跳失率增幅",
      "base": "≤ 2%",
      "threshold": "> 5% 停止扩量"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "feature-coldstart"
}
