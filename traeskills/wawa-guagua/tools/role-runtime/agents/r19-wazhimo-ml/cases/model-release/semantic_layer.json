{
  "_note": "R19「不完整模型卡 + 无溯源资产」语义层。枚举口径来自 mlflow__mlflow 的模型元数据与 artifact 口径（runs:/<run_id>/<path>）。门禁与边界是对 R19「模型卡是交付说明书、资产必须可追溯」的可执行化。",
  "artifact_type": "model_card",
  "terms": [
    {"term": "intended_use", "meaning": "模型预期用途，必填；写清给谁、用来干什么", "source": "model card 口径"},
    {"term": "limitations", "meaning": "模型限制，必填；写清「不能用来干什么」", "source": "model card 口径"},
    {"term": "risk_tier", "meaning": "风险分层：low/medium/high，三档白名单", "source": "R19 模型卡口径"},
    {"term": "license", "meaning": "许可：proprietary/open_source/research_only", "source": "R19 模型卡口径"},
    {"term": "known_bias", "meaning": "已知偏差，必填伦理/合规项", "source": "model card 口径"},
    {"term": "artifact", "meaning": "运行产物：模型文件/评估报告/图表，须能追溯到 run_id", "source": "mlflow artifact"},
    {"term": "run_id", "meaning": "产生资产的运行 ID，资产溯源的关键绑定", "source": "mlflow tracking"},
    {"term": "stage", "meaning": "注册阶段：none/staging/production/archived", "source": "mlflow Model Registry"}
  ],
  "gates": [
    {"id": "G1", "when": "card.intended_use 为空", "verdict": "BLOCKER", "action": "拒绝，补用途"},
    {"id": "G2", "when": "card.limitations 为空", "verdict": "BLOCKER", "action": "拒绝，补限制（必须写清不能干什么）"},
    {"id": "G3", "when": "card.risk_tier 不在 {low,medium,high}", "verdict": "BLOCKER", "action": "拒绝，补合规风险分层"},
    {"id": "G4", "when": "card.license 不在白名单", "verdict": "BLOCKER", "action": "拒绝，补合法许可"},
    {"id": "G5", "when": "card.known_bias 为空", "verdict": "BLOCKER", "action": "拒绝，补已知偏差"},
    {"id": "G6", "when": "asset.path 为空", "verdict": "BLOCKER", "action": "拒绝，资产不可定位"},
    {"id": "G7", "when": "asset.run_id 为空", "verdict": "BLOCKER", "action": "拒绝，资产不可溯源"},
    {"id": "G8", "when": "asset.type 不在白名单", "verdict": "BLOCKER", "action": "拒绝，资产类型非法"}
  ],
  "boundary": [
    {"out_of_scope": "模型权重的实际打包 / 分发 / 部署", "owner": "R09 蛙联调", "r19_role": "只产出模型卡与资产证据工件，不分发模型"},
    {"out_of_scope": "模型风险的业务影响评估", "owner": "R03 AI 治理", "r19_role": "移交，R19 只做风险分层登记"},
    {"out_of_scope": "许可证的法律效力判定", "owner": "R03 + 人工", "r19_role": "移交，R19 只做许可白名单校验"}
  ],
  "decision_order": [
    "先校验模型卡五要素：用途/限制/风险分层/许可/已知偏差，任一缺直接拒绝",
    "再校验资产清单：路径非空、run_id 非空、类型合法",
    "资产必须能追溯到 run_id，否则视为无溯源，拒收",
    "模型卡是交付说明书不是营销页，限制与偏差为空零容忍"
  ]
}
