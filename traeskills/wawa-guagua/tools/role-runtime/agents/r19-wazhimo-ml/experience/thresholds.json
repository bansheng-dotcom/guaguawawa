{
  "_note": "R19 蛙智模 全局阈值（T9 外置）。键名必须与 skills/_common.py 的 _DEFAULT_THRESHOLDS 严格一致（R05 踩坑：键名错位比逻辑错位更难查）。枚举口径来自来源仓库 mlflow__mlflow 的 assistant/skills。",
  "tracking": {
    "experiment_kinds": ["genai_development", "custom_model_development"],
    "use_cases": ["genai", "traditional_ml"]
  },
  "registry": {
    "stages": ["none", "staging", "production", "archived"],
    "model_sources": ["mlflow", "dspy", "litellm", "custom"]
  },
  "evaluation": {
    "scorer_types": ["deterministic", "llm_judge", "code"],
    "feedback_sources": ["HUMAN", "LLM_JUDGE", "CODE", "WEBHOOK"],
    "eval_modes": ["rerun", "precomputed"],
    "default_dry_run_rows": 3
  },
  "trace": {
    "trace_states": ["OK", "ERROR", "IN_PROGRESS", "STATUS_CODE_UNSET"],
    "span_types": ["LLM", "TOOL", "RETRIEVER", "CHAIN", "AGENT", "CHAT_MODEL",
                   "EMBEDDING", "GUARDRAIL", "RERANKER"]
  },
  "release": {
    "verdicts": ["PASS", "BLOCK", "NEEDS_REVIEW"],
    "diagnosis_layers": ["capability", "data", "routing", "instruction",
                         "knowledge", "reward"]
  },
  "monitor": {
    "metric_views": ["TRACES", "SPANS", "ASSESSMENTS"],
    "aggregations": ["COUNT", "SUM", "AVG", "P95"],
    "metric_names": ["total_tokens", "latency", "trace_count", "assessment_value"]
  },
  "modelcard": {
    "risk_tiers": ["low", "medium", "high"],
    "license_types": ["proprietary", "open_source", "research_only"]
  },
  "review": {
    "credential_words": ["api_key", "apikey", "secret", "password", "token",
                         "private_key", "私钥", "密钥", "密码", "连接串",
                         "connection_string", "client_secret"],
    "fake_pass_words": ["效果不错", "看起来好", "应该没问题", "主观感觉",
                        "凭经验判断", "直接上线", "跳过评估"],
    "scope_terms": ["统计结论", "相关性分析", "显著性检验", "业务归因",
                    "增长建议", "决策建议", "回归分析", "p值", "置信区间",
                    "财务预测", "税务结论"],
    "handoff_keys": ["handoff", "授权", "authorized", "approved_by",
                     "approver", "移交", "交接", "复核", "审批"],
    "concrete_keys": ["experiment_id", "run_id", "model_name", "version",
                      "dataset_id", "scorer_name", "trace_id", "metric_name",
                      "candidate_id", "card_id", "span_count", "metric_count",
                      "score_count", "check_count", "stage", "verdict"],
    "conclusion_keys": ["summary", "note", "next", "description", "conclusion",
                        "recommendation", "reason", "narrative", "insight"]
  }
}
