{
  "_note": "蛙引流（Growth / 增长黑客）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r12",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Growth / 增长黑客",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "fake_ratio",
      "name": "伪泛粉占比",
      "formula": "无效互动用户 / 新增用户",
      "unit": "%",
      "target": "≤ 20%",
      "alert": "> 40% 立即调整定向"
    },
    {
      "id": "roi",
      "name": "渠道 ROI",
      "formula": "渠道毛利 / 渠道花费",
      "unit": "×",
      "target": "≥ 2",
      "alert": "< 1.5 连续 3 天停投"
    },
    {
      "id": "d1",
      "name": "次留率",
      "formula": "次日回访用户 / 新增用户",
      "unit": "%",
      "target": "≥ 25",
      "alert": "< 15 判定渠道无效"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "伪泛粉 > 40%",
      "verdict": "BLOCKER",
      "action": "停机复审定向"
    },
    {
      "id": "G2",
      "when": "归因窗口不一致",
      "verdict": "WARN",
      "action": "统一归因口径后再比较"
    },
    {
      "id": "G3",
      "when": "单位经济为负仍加投",
      "verdict": "BLOCKER",
      "action": "立即停投"
    }
  ],
  "guardrails": [
    {
      "dim": "伪泛粉占比",
      "metric": "伪泛粉占比",
      "base": "≤ 20%",
      "threshold": "> 40% 立即调整定向"
    },
    {
      "dim": "渠道 ROI",
      "metric": "渠道 ROI",
      "base": "≥ 2",
      "threshold": "< 1.5 连续 3 天停投"
    },
    {
      "dim": "次留率",
      "metric": "次留率",
      "base": "≥ 25",
      "threshold": "< 15 判定渠道无效"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "channel-attribution"
}
