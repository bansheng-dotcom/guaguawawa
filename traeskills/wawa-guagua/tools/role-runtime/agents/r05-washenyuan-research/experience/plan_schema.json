{
  "_comment": "分析计划（Analysis Plan）契约：每次研究/分析请求必须先输出符合此格式的计划；harness 做确定性校验（复用 r06 plan_schema 口径）。",
  "required_fields": [
    "round",
    "analytical_step",
    "question",
    "query_spec",
    "expected_output",
    "acceptance_criteria",
    "stop_condition"
  ],
  "analytical_step_enum": [
    "trend_analysis",
    "decomposition",
    "attribution",
    "risk_mining"
  ],
  "query_spec_required": [
    "metrics",
    "group_by",
    "date_range"
  ],
  "expected_output_required": [
    "format",
    "required_fields"
  ],
  "acceptance_criteria_required": [
    "min_rows",
    "all_required_fields"
  ],
  "stop_condition_required": [
    "if_impact_below_pct",
    "reason"
  ]
}
