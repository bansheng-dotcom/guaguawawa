{
  "_note": "蛙挑刺（Reviewer / 对抗质检）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r04",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Reviewer / 对抗质检",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "l2_completeness",
      "name": "L2 实质性证据完备度",
      "formula": "已提供实质证据条目 / 应提供条目",
      "unit": "%",
      "target": "100%",
      "alert": "< 100% 即刻驳回"
    },
    {
      "id": "stub_hits",
      "name": "占位实现命中数",
      "formula": "stub/TODO/NotImplemented 出现次数",
      "unit": "处",
      "target": "0",
      "alert": "≥ 1 判不通过"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "L1 存在性通过但 L2 实质性为空",
      "verdict": "BLOCKER",
      "action": "判 REJECT，退回补证"
    },
    {
      "id": "G2",
      "when": "发现 stub/TODO 占位实现",
      "verdict": "BLOCKER",
      "action": "判不通过，不得进入下游"
    },
    {
      "id": "G3",
      "when": "结论无来源引用",
      "verdict": "BLOCKER",
      "action": "驳回并要求标注来源"
    }
  ],
  "guardrails": [
    {
      "dim": "L2 实质性证据完备度",
      "metric": "L2 实质性证据完备度",
      "base": "100%",
      "threshold": "< 100% 即刻驳回"
    },
    {
      "dim": "占位实现命中数",
      "metric": "占位实现命中数",
      "base": "0",
      "threshold": "≥ 1 判不通过"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "artifact-reject"
}
