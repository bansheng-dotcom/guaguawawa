{
  "_note": "蛙织网（Automation / 自动化）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r17",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Automation / 自动化",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "dlq_retry",
      "name": "死信重试次数",
      "formula": "同一消息重试计数",
      "unit": "次",
      "target": "≤ 1",
      "alert": "> 3 报警停工单"
    },
    {
      "id": "dangling",
      "name": "悬空连线数",
      "formula": "指向不存在节点的边数",
      "unit": "条",
      "target": "0",
      "alert": "≥ 1 禁止发布"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "出现悬空连线或未接失败分支",
      "verdict": "BLOCKER",
      "action": "禁止发布"
    },
    {
      "id": "G2",
      "when": "凭据明文出现在流程定义",
      "verdict": "BLOCKER",
      "action": "立即轮换密钥"
    },
    {
      "id": "G3",
      "when": "涉及资金/删除无人工审批",
      "verdict": "BLOCKER",
      "action": "补审批门"
    }
  ],
  "guardrails": [
    {
      "dim": "死信重试次数",
      "metric": "死信重试次数",
      "base": "≤ 1",
      "threshold": "> 3 报警停工单"
    },
    {
      "dim": "悬空连线数",
      "metric": "悬空连线数",
      "base": "0",
      "threshold": "≥ 1 禁止发布"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "workflow-reliability"
}
