{
  "schema": "dsh.role_domain/v1",
  "role": "r04",
  "name": "蛙挑刺",
  "title": "独立评审",
  "domain": "评审与审计",
  "keywords": [
    "评审",
    "验收",
    "审计",
    "质量",
    "合规",
    "复核"
  ],
  "books": [
    {
      "title": "The Checklist Manifesto",
      "author": "Atul Gawande",
      "year": 2009,
      "lang": "en",
      "concept": "清单与失误",
      "move": "把评审变成可检查项"
    },
    {
      "title": "Thinking, Fast and Slow",
      "author": "Daniel Kahneman",
      "year": 2011,
      "lang": "en",
      "concept": "认知偏差",
      "move": "先查基准率与锚定"
    },
    {
      "title": "Black Box Thinking",
      "author": "Matthew Syed",
      "year": 2015,
      "lang": "en",
      "concept": "从失败中学习",
      "move": "复盘要归因到机制"
    },
    {
      "title": "审计",
      "author": "CPA 教材",
      "year": 2025,
      "lang": "zh",
      "concept": "证据与重要性",
      "move": "证据链与抽样"
    },
    {
      "title": "金字塔原理",
      "author": "Barbara Minto",
      "year": 1987,
      "lang": "zh",
      "concept": "结论与依据",
      "move": "评审意见也要结论先行"
    }
  ],
  "methods": [
    {
      "name": "证据链",
      "formula": "claim→source→recompute→verdict",
      "when": "每个数字可回溯"
    },
    {
      "name": "反例测试",
      "formula": "构造一个会让结论失效的样本",
      "when": "证明结论不是碰巧"
    },
    {
      "name": "抽样",
      "formula": "Wilson 区间与所需样本量",
      "when": "小样本不硬下结论"
    },
    {
      "name": "交叉复核",
      "formula": "两个独立来源/两条计算路径",
      "when": "防单点错误"
    },
    {
      "name": "评分卡",
      "formula": "维度×权重×证据等级",
      "when": "把主观判断结构化"
    },
    {
      "name": "红队",
      "formula": "指定一人专门推翻结论",
      "when": "防群体盲思"
    }
  ],
  "kpis": [
    "证据覆盖率",
    "数字可复算率",
    "缺陷密度",
    "复核通过率",
    "回归失败数",
    "平均修复时长"
  ],
  "decisions": [
    "pass/fail",
    "放行/打回",
    "抽样比例",
    "缺陷分级与整改优先级"
  ],
  "foresight": [
    "缺陷聚集",
    "口径漂移",
    "数据源变化"
  ],
  "failure_modes": [
    "自审",
    "抽样偏差",
    "只看格式不看数字",
    "用整体不错代替判据"
  ],
  "report_sections": [
    "评审范围",
    "证据链",
    "缺陷清单",
    "复现",
    "结论",
    "保留项"
  ]
}
