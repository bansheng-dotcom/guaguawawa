      "lang": "zh",
      "concept": "维度建模",
      "move": "事实与维度"
    }
  ],
  "methods": [
    {
      "name": "维度建模",
      "formula": "事实表+维度表+一致性维度",
      "when": "可分析"
    },
    {
      "name": "分层",
      "formula": "ODS→DWD→DWS→ADS",
      "when": "复用与口径"
    },
    {
      "name": "质量六维",
      "formula": "完整/准确/一致/及时/唯一/有效",
      "when": "数据可信"
    },
    {
      "name": "血缘",
      "formula": "表→字段→指标的有向图；影响面=下游节点数",
      "when": "影响分析"
    },
    {
      "name": "增量/全量",
      "formula": "CDC/快照/拉链",
      "when": "成本与时效"
    },
    {
      "name": "SCD",
      "formula": "缓慢变化维类型 1/2/3",
      "when": "历史可追溯"
    }
  ],
  "kpis": [
    "数据延迟",
    "准确率",
