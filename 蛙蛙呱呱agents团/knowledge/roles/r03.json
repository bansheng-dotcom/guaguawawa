    },
    {
      "name": "现金流折现",
      "formula": "EV=ΣFCF/(1+WACC)^t + 终值",
      "when": "给业务估值与取舍"
    },
    {
      "name": "三表勾稽",
      "formula": "利润→经营现金流→资产负债表变动",
      "when": "识别利润是否变成现金"
    },
    {
      "name": "敏感性/情景",
      "formula": "关键假设 ±20% 对 NPV/利润的影响",
      "when": "给区间，不给点值"
    },
    {
      "name": "单位经济",
      "formula": "单客/单店/单吨贡献毛利与回本周期",
      "when": "判断规模是否放大亏损"
    },
    {
      "name": "营运资金周期",
      "formula": "DSO+DIO-DPO",
      "when": "现金被谁占用"
    }
