{
  "_comment": "v2 修复后证据：真阻断表述 + signals 补齐 test 运行记录 → 0 命中",
  "harness_name": "ci-deploy-gate",
  "hooks": [
    {"name": "deploy-gate", "text": "deploy gate: blocks the release when any check fails"}
  ],
  "docs": [],
  "baseline": {"auto_update": false},
  "skip_categories": [{"name": "flaky", "justification": "已知 flaky，跟踪单 #42"}],
  "layers": ["lint", "test"],
  "thresholds": {"lint": "error", "test": "error"},
  "default_tier": "strict",
  "baseline_update_pr": {"auto_approve": false, "reviewers": ["r03"]},
  "snapshot": {
    "passed": true,
    "checks": ["lint", "test"],
    "signals": {"lint": {"ran": true, "exit_code": 0}, "test": {"ran": true, "exit_code": 0}}
  }
}
