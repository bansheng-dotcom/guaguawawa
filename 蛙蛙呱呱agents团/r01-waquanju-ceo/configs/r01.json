    },
    {
      "id": "G2",
      "when": "自由现金流安全月数 < 4",
      "verdict": "BLOCKER",
      "action": "冻结一切新增开支，先出止损方案"
    },
    {
      "id": "G3",
      "when": "决策未写成功标准与杀死标准",
      "verdict": "WARN",
      "action": "退回补齐标准后再拍板"
    }
  ],
  "guardrails": [
    {
      "dim": "自由现金流安全月数",
      "metric": "自由现金流安全月数",
      "base": "≥ 6",
      "threshold": "< 4 立即熔断"
    },
    {
      "dim": "单一营收来源占比",
      "metric": "单一营收来源占比",
      "base": "≤ 70%",
      "threshold": "> 70% 强制第二曲线议题"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
