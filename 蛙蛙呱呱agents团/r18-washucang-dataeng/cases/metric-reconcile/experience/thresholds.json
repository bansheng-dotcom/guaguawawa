{
  "_note": "metric-reconcile 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "reconcile_diff": {
      "name": "跨表对账差异率",
      "formula": "|A − B| / A",
      "unit": "%",
      "target": "≤ 0.05",
      "alert": "> 0.1 阻断下游"
    },
    "freshness": {
      "name": "数据延迟",
      "formula": "当前时间 − 最新分区时间",
      "unit": "h",
      "target": "≤ 1",
      "alert": "> 6 标记不可用"
    }
  },
  "gates": {
    "G1": {
      "when": "对账差异 > 0.1%",
      "verdict": "BLOCKER",
      "action": "阻断下游消费"
    },
    "G2": {
      "when": "主键唯一率 < 99.9%",
      "verdict": "BLOCKER",
      "action": "停止入仓"
    },
    "G3": {
      "when": "血缘缺失",
      "verdict": "WARN",
      "action": "补血缘后再发布"
    }
  }
}
