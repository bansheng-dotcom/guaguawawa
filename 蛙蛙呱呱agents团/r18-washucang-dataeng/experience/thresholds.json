    "default_max_age_hours": 24
  },
  "incremental": {
    "modes": ["full_refresh", "incremental", "snapshot", "cdc"],
    "partitions": ["none", "hourly", "daily", "monthly"]
  },
  "catalog": {
    "field_types": ["string", "integer", "number", "boolean", "timestamp", "date", "json"]
  },
  "ops": {
    "operations": ["backfill", "migration", "export", "delete"],
    "authorizations": ["authorized", "approved", "pending"]
  },
  "review": {
    "credential_words": ["api_key", "apikey", "secret", "password", "token", "private_key", "私钥", "密钥", "密码", "连接串", "connection_string", "client_secret"],
    "execution_words": ["直接回填", "直接删除", "直接外发", "直接迁移", "直接改生产", "直接drop", "直接truncate", "直接清空", "立即删除", "立即外发", "未经审批执行"],
