    "handoff_keys": ["handoff", "授权", "authorized", "approved_by", "approver", "移交", "交接", "复核", "审批"],
    "concrete_keys": ["connection_id", "source_connector", "destination_connector", "stream_count", "model_name", "test_count", "dag_id", "task_count", "table", "check_count", "stream", "mode", "operation", "alert_count", "edge_count", "table_count"],
    "conclusion_keys": ["summary", "note", "next", "description", "conclusion", "recommendation", "reason", "narrative", "insight"]
