{
  "role_id": "r20",
  "domain": "可靠性与恢复",
  "max_questions": 2,
  "execution_inputs": {
    "service": {
      "resolve": "task_port",
      "question": "服务/系统的清单在哪？",
      "default": "workspace/artifacts/services.csv"
    }
  },
  "lexicon": {
    "service": {
      "checkout": [
        "下单服务",
        "checkout"
      ],
      "payment": [
        "支付服务",
        "payment"
      ],
      "api": [
        "网关",
        "api"
      ],
      "db": [
        "数据库",
        "db"
      ]
    },
    "metric": {
      "latency": [
        "延迟",
        "p95"
      ],
      "uptime": [
        "可用率",
        "uptime"
      ],
      "error_rate": [
        "错误率",
        "5xx"
      ]
    },
    "scope": {
      "all": [
        "全量",
        "全部",
        "整体"
      ],
      "single": [
        "单个服务",
        "单实例"
      ]
    },
    "time_window": {
      "today": [
        "今天",
        "当日"
      ],
      "last_7d": [
        "近7天",
        "上周",
        "近一周"
      ],
      "last_30d": [
        "近30天",
        "上个月",
        "近一个月"
      ]
    }
  },
  "assumptions": {
    "scope": "all",
    "time_window": "last_7d"
  },
  "assumption_reason": {
    "scope": "未指定范围，按全量口径",
    "time_window": "未指定时间窗，按近7天口径，结论首行标注"
  },
  "questions": {
    "action": {
      "question": "你想处理哪类可靠性事项？",
      "options": [
        {
          "value": "uptime",
          "label": "可用率"
        },
        {
          "value": "alert",
          "label": "告警"
        },
        {
          "value": "backup",
          "label": "备份"
        },
        {
          "value": "rpo_rto",
          "label": "RPO/RTO"
        }
      ]
    },
    "service": {
      "question": "是哪个服务？",
      "options": [
        {
          "value": "checkout",
          "label": "下单服务"
        },
        {
          "value": "payment",
          "label": "支付服务"
        },
        {
          "value": "api",
          "label": "网关 API"
        },
        {
          "value": "db",
          "label": "数据库"
        }
      ]
    },
    "metric": {
      "question": "看哪个可靠性指标？",
      "options": [
        {
          "value": "latency",
          "label": "延迟"
        },
        {
          "value": "uptime",
          "label": "可用率"
        },
        {
          "value": "error_rate",
          "label": "错误率"
        }
      ]
    },
    "scope": {
      "question": "处理范围是？",
      "options": [
        {
          "value": "all",
          "label": "全量"
        },
        {
          "value": "single",
          "label": "单个服务"
        }
      ]
    }
  },
  "actions": [
    {
      "skill": "monitor",
      "action": "uptime",
      "label": "可用率",
      "when": [
        "可用率",
        "uptime",
        "在线率",
        "可用性记录"
      ],
      "requires": [
        "service"
      ],
      "params": {
        "service": "$service"
      }
    },
    {
      "skill": "monitor",
      "action": "monitor",
      "label": "监控探测",
      "when": [
        "监控",
        "探测",
        "心跳",
        "monitor"
      ],
      "requires": [
        "metric"
      ],
      "params": {
        "metric": "$metric"
      }
    },
    {
      "skill": "alert",
      "action": "alert",
      "label": "告警配置",
      "when": [
        "告警",
        "报警",
        "通知渠道",
        "阈值告警"
      ],
      "requires": [
        "service"
      ],
      "params": {
        "service": "$service"
      }
    },
    {
      "skill": "backup",
      "action": "backup",
      "label": "备份",
      "when": [
        "备份",
        "backup",
        "restic",
        "备份仓"
      ],
      "requires": [
        "scope"
      ],
      "params": {
        "scope": "$scope"
      }
    },
    {
      "skill": "restore",
      "action": "drill",
      "label": "恢复演练",
      "when": [
        "演练",
        "drill",
        "能否恢复",
        "恢复验证"
      ],
      "requires": [
        "scope"
      ],
      "params": {
        "scope": "$scope"
      }
    },
    {
      "skill": "dr",
      "action": "rpo_rto",
      "label": "RPO/RTO",
      "when": [
        "rpo",
        "rto",
        "恢复点",
        "恢复时间",
        "灾难恢复"
      ],
      "requires": [
        "service"
      ],
      "params": {
        "service": "$service"
      }
    },
    {
      "skill": "postmortem",
      "action": "postmortem",
      "label": "故障复盘",
      "when": [
        "复盘",
        "postmortem",
        "事故分析",
        "故障复盘"
      ],
      "requires": [
        "scope"
      ],
      "params": {
        "scope": "$scope"
      }
    },
    {
      "skill": "statuspage",
      "action": "incident",
      "label": "故障通告",
      "when": [
        "故障通告",
        "状态页",
        "incident"
      ],
      "requires": [
        "service"
      ],
      "params": {
        "service": "$service"
      }
    },
    {
      "skill": "dr",
      "action": "rollback",
      "label": "版本回滚",
      "when": [
        "回滚",
        "rollback",
        "版本回退"
      ],
      "requires": [
        "service"
      ],
      "params": {
        "service": "$service"
      }
    },
    {
      "skill": "alert",
      "action": "escalation",
      "label": "告警升级",
      "when": [
        "升级通知",
        "升级策略",
        "escalation"
      ],
      "requires": [
        "service"
      ],
      "params": {
        "service": "$service"
      }
    }
  ],
  "semantic_fields": {
    "statuspage.statuspage": [
      "service"
    ],
    "backup.snapshot": [
      "service",
      "time_window"
    ],
    "restore.restore": [
      "service",
      "time_window"
    ],
    "postmortem.improvement": [
      "service",
      "scope"
    ]
  },
  "l2_prompt_blocks": [
    {
      "name": "时间线与根因",
      "template": "事件时间必须单调递增且带时区；根因不得写「人为失误」，要写清机制与失效点；分级必须按影响面与时长判定，不按情绪。"
    },
    {
      "name": "恢复验证",
      "template": "恢复必须给实测 RPO/RTO 与验证方式（真的读回来了吗）；演练必须留下证据（时间戳、校验和、抽样比对），不能只写「已恢复」。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "服务范围",
      "时间窗",
      "指标口径",
      "结论",
      "恢复验证结果"
    ]
  }
}
