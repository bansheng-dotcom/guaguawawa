  "l2_prompt_blocks": [
    {
      "name": "口径与勾稽",
      "template": "先声明口径（合并/单体、含税/不含税、权责/收付），再做勾稽：资产=负债+权益；每个数字必须挂凭证号或报表行号；三表对不上时只报差异，不下结论。"
    },
    {
      "name": "禁区",
      "template": "不给投资建议、不预测股价与汇率、不代签合同；涉及税务只描述边界，不替代专业意见。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "查询口径",
      "账期",
      "数据来源",
      "结论",
      "风险提示"
    ]
  },
