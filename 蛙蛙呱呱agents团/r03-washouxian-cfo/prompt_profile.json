        "period"
      ],
      "params": {
        "period": "$period"
      }
    },
    {
      "skill": "financial",
      "action": "rollforward",
      "label": "月结滚调",
      "when": [
        "月结",
        "关账",
        "滚调",
        "rollforward"
      ],
      "requires": [
        "period"
      ],
      "params": {
        "period": "$period"
      }
    },
