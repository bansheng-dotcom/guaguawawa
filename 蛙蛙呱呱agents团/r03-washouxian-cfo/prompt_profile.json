{
  "role_id": "r03",
  "domain": "财务与合规",
  "max_questions": 2,
  "execution_inputs": {
    "ledger": {
      "resolve": "task_port",
      "question": "财务数据文件在哪？",
      "default": "workspace/artifacts/ledger.csv"
    },
    "artifact": {
      "resolve": "task_port",
      "question": "待审查的合同/政策/隐私声明/数据清单在哪？"
    }
  },
  "lexicon": {
    "period": {
      "monthly": [
        "本月",
        "这个月",
        "当月",
        "月度",
        "月"
      ],
      "quarter": [
        "本季度",
        "这季度",
        "季度"
      ],
      "yearly": [
        "今年",
        "本年度",
        "全年"
      ]
    },
    "metric": {
      "ltv": [
        "ltv",
        "生命周期价值"
      ],
      "cac": [
        "cac",
        "获客成本"
      ],
      "payback": [
        "回本周期",
        "payback"
      ]
    },
