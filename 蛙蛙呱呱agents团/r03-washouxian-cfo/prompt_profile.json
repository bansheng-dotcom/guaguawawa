  },
  "assumptions": {
    "period": "monthly"
  },
  "assumption_reason": {
    "period": "未指定账期，按本月账期口径，结论首行标注"
  },
  "questions": {
    "action": {
      "question": "你想看哪类财务/合规事项？",
      "options": [
        {
          "value": "recon",
          "label": "对账调节"
        },
        {
          "value": "runway",
          "label": "现金跑道"
        },
        {
          "value": "unitecon",
          "label": "单位经济"
        },
        {
          "value": "healthcheck",
          "label": "财务健康体检"
        }
      ]
    },
    "period": {
      "question": "看哪个账期？",
      "options": [
        {
          "value": "monthly",
          "label": "本月"
        },
        {
          "value": "quarter",
          "label": "本季度"
        },
        {
          "value": "yearly",
          "label": "本年"
        }
      ]
    },
    "metric": {
      "question": "看哪个单位经济指标？",
      "options": [
        {
          "value": "ltv",
          "label": "LTV"
        },
        {
          "value": "cac",
          "label": "CAC"
        },
        {
          "value": "payback",
          "label": "回本周期"
        }
      ]
    }
  },
  "actions": [
