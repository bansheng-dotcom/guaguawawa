{
  "_note": "蛙成美（Design / 创意视觉）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r10",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Design / 创意视觉",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "render_block",
      "name": "视觉资源渲染阻滞",
      "formula": "首屏视觉资源阻塞主线程时长",
      "unit": "ms",
      "target": "≤ 150",
      "alert": "> 300 优化图层"
    },
    {
      "id": "token_coverage",
      "name": "设计 Token 覆盖率",
      "formula": "使用 Token 的属性 / 总属性",
      "unit": "%",
      "target": "100%",
      "alert": "< 80% 禁止交付前端"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "对比度 < 3:1",
      "verdict": "BLOCKER",
      "action": "判定不可用，重做配色"
    },
    {
      "id": "G2",
      "when": "渲染阻滞 > 300ms",
      "verdict": "WARN",
      "action": "优化图层或降级素材"
    },
    {
      "id": "G3",
      "when": "Token 覆盖率 < 80%",
      "verdict": "BLOCKER",
      "action": "禁止交付前端"
    }
  ],
  "guardrails": [
    {
      "dim": "视觉资源渲染阻滞",
      "metric": "视觉资源渲染阻滞",
      "base": "≤ 150",
      "threshold": "> 300 优化图层"
    },
    {
      "dim": "设计 Token 覆盖率",
      "metric": "设计 Token 覆盖率",
      "base": "100%",
      "threshold": "< 80% 禁止交付前端"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "brand-refresh"
}
