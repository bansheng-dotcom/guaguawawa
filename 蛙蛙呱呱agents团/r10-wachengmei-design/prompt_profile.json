  "l2_prompt_blocks": [
    {
      "name": "视觉约束",
      "template": "设计对象：{topic}；风格：{style}；端：{platform}。先定调性与色板，再落到尺寸与栅格，禁止未定调性就出图。"
    },
    {
      "name": "可交付自检",
      "template": "交付必须含：尺寸/比例、色值（HEX）、字体与字重、导出格式；缺任一项视为半成品。"
    },
    {
      "name": "禁用词与反例",
      "template": "禁止「赋能、闭环、抓手、高级感拉满」等空话；禁止只给形容词不给参数，禁止无版权来源的素材。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
