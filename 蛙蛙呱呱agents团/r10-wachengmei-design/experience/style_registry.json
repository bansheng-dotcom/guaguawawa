    {
      "id": "baoyu-styles",
      "title": "baoyu-article-illustrator style reference",
      "url": "https://github.com/Quriosity-agent/qcut/blob/master/qcut/resources/default-skills/qcut-toolkit/baoyu/baoyu-article-illustrator/references/styles.md",
      "used_for": "新增 10 条风格：notion-sketch / chalkboard / scientific / editorial / fantasy-animation / flat-doodle / sketch / sketch-notes / vintage-print / retro"
    }
  ],
  "hard_limits": {
    "note": "任何 style 与 recipe 都绕不过去的模型结构限制。命中时不要硬跑生图，改走后期或换交付形态。",
    "items": [
      {
        "id": "exact-typography",
        "desc": "精确字体/字重/字距、指定字库",
        "workaround": "AI 只出图形，文字在 Figma/AI 里重排"
      },
      {
        "id": "cjk-wordmark",
        "desc": "中/日/韩字标可读性（多数模型为 C/D 级）",
        "workaround": "字标只生成图形部分，中文后期排版"
      },
      {
        "id": "real-logo",
        "desc": "复刻真实商标/品牌资产",
        "workaround": "不生成，直接用授权矢量文件"
      },
      {
        "id": "precise-data",
        "desc": "确定数字、百分比、图表刻度",
        "workaround": "生成容器与配色，数据后期填"
      },
      {
        "id": "character-consistency",
        "desc": "同一角色多视角/多姿态保持一致",
        "workaround": "单张定稿 + 参考图/LoRA，三视图人工修"
      },
      {
        "id": "multi-panel",
        "desc": "多格漫画的跨格一致性",
        "workaround": "逐格生成 + 统一参考图"
      },
      {
        "id": "editable-vector",
        "desc": "可直接编辑的矢量路径",
        "workaround": "位图 → VTrace/Image Trace → 手工修节点"
      },
      {
        "id": "exact-dimensions",
        "desc": "严格物理尺寸/出血/印刷规格",
        "workaround": "按规格后期裁切、补出血、打样"
      }
    ]
  }
