{
  "_note": "brand-refresh 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "render_block": {
      "name": "视觉资源渲染阻滞",
      "formula": "首屏视觉资源阻塞主线程时长",
      "unit": "ms",
      "target": "≤ 150",
      "alert": "> 300 优化图层"
    },
    "token_coverage": {
      "name": "设计 Token 覆盖率",
      "formula": "使用 Token 的属性 / 总属性",
      "unit": "%",
      "target": "100%",
      "alert": "< 80% 禁止交付前端"
    }
  },
  "gates": {
    "G1": {
      "when": "对比度 < 3:1",
      "verdict": "BLOCKER",
      "action": "判定不可用，重做配色"
    },
    "G2": {
      "when": "渲染阻滞 > 300ms",
      "verdict": "WARN",
      "action": "优化图层或降级素材"
    },
    "G3": {
      "when": "Token 覆盖率 < 80%",
      "verdict": "BLOCKER",
      "action": "禁止交付前端"
    }
  }
}
