  "l2_prompt_blocks": [
    {
      "name": "证据锚定",
      "template": "研究对象：{topic}；市场口径：{market}。每条结论必须绑定可核查来源（报告名/年份/链接），无来源的断言一律标注「未验证」。"
    },
    {
      "name": "研究语气",
      "template": "用事实与数字说话，先结论后证据；禁止使用「赋能、闭环、抓手、打造、颠覆」等空话。"
    },
    {
      "name": "反例约束",
      "template": "不得编造市场规模与竞品数据；缺失项写「待补」并给出取数路径，不得用行业常识凑数。"
    },
    {
      "name": "假设-证伪台账",
      "template": "研究对象：{topic}；市场口径：{market}。每条假设必须写三列：假设 / 杀死标准（什么证据出现就作废）/ 当前状态。没有杀死标准的假设不进结论，只能写成「待验证」。"
    },
    {
      "name": "来源饱和",
      "template": "同一结论至少 3 个相互独立的来源（不同机构、不同采集方法、不同时间）；不足 3 个时结论降级为「单源待证」，并写明还缺哪一类来源（官方 / 媒体 / 一线）。"
    },
    {
      "name": "三角验证",
      "template": "关键数字须用官方口径 / 媒体报道 / 一线访谈三类互证；三类冲突时按口径新旧与样本范围择一，并在边界写清未采用哪一类口径、为什么。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "研究问题",
      "证据清单",
      "结论与置信度",
      "待验证项"
    ]
  },
