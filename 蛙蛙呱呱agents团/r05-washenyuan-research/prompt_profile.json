  "l2_prompt_blocks": [
    {
      "name": "证据锚定",
      "template": "研究对象：{topic}；市场口径：{market}。每条结论必须绑定可核查来源（报告名/年份/链接），无来源的断言一律标注「未验证」。"
    },
    {
      "name": "研究语气",
      "template": "用事实与数字说话，先结论后证据；禁止使用「赋能、闭环、抓手、打造、颠覆」等空话。"
    },
    {
      "name": "反例约束",
      "template": "不得编造市场规模与竞品数据；缺失项写「待补」并给出取数路径，不得用行业常识凑数。"
    }
  ],
