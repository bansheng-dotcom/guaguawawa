{
 "proposition": "同一份订单的跨技能串行分析（质量→回归→卡方→报告）",
 "steps": [
  {
   "id": "q",
   "type": "skill",
   "skill": "quality",
   "args": [
    "audit",
    "--input",
    "{AGENTS}/tests/fixtures/analysis_orders.csv",
    "--pk",
    "order_id",
    "--date",
    "order_date"
   ]
  },
  {
   "id": "a1",
   "type": "assert",
   "path": "q.dims_active",
   "equals": 6
  },
  {
   "id": "reg",
   "type": "skill",
   "skill": "regression",
   "args": [
    "--input",
    "{AGENTS}/tests/fixtures/analysis_orders.csv",
    "--x",
    "unit_price,discount",
    "--y",
    "revenue",
    "--cluster",
    "channel"
   ]
  },
  {
   "id": "a2",
   "type": "assert",
   "path": "reg.multivariate.r2",
   "equals": null
  },
  {
   "id": "chi",
   "type": "skill",
   "skill": "chi2",
   "args": [
    "--input",
    "{AGENTS}/tests/fixtures/analysis_orders.csv",
    "--row",
    "category",
    "--col",
    "returned"
   ]
  },
  {
   "id": "a3",
   "type": "assert",
   "path": "chi.chi2.p_exact",
   "equals": null
  },
  {
   "id": "r",
   "type": "report",
   "path": "report.md"
  }
 ]
}