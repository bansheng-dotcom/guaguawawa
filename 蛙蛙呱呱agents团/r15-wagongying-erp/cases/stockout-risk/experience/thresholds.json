{
  "_note": "stockout-risk 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "safety_days": {
      "name": "安全库存天数",
      "formula": "可用库存 / 日均消耗",
      "unit": "天",
      "target": "≥ 14",
      "alert": "< 7 紧急补货"
    },
    "turnover": {
      "name": "库存周转天数",
      "formula": "平均库存 / 日均销货成本",
      "unit": "天",
      "target": "≤ 45",
      "alert": "> 60 清库"
    }
  },
  "gates": {
    "G1": {
      "when": "安全库存 < 7 天",
      "verdict": "BLOCKER",
      "action": "当日下补货单"
    },
    "G2": {
      "when": "三单匹配率 < 95%",
      "verdict": "BLOCKER",
      "action": "暂停付款"
    },
    "G3": {
      "when": "周转 > 60 天",
      "verdict": "WARN",
      "action": "启动清库与促销"
    }
  }
}
