  "l2_prompt_blocks": [
    {
      "name": "单据链",
      "template": "每个数量必须能追到单据号；收货数量不得超采购订单；库存分录用途必须在白名单（采购入库/销售出库/调拨/盘盈盘亏）。"
    },
    {
      "name": "数量守恒",
      "template": "期初+入库-出库=期末；在途与占用分开算，不得合并成「可用」。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "业务口径",
      "时间窗",
      "对象维度",
      "结论",
      "单据号"
    ]
  },
