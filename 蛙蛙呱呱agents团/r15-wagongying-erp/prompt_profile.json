  },
  "questions": {
    "action": {
      "question": "你想处理哪类供应链事项？",
      "options": [
        {
          "value": "quotation",
          "label": "报价比价"
        },
        {
          "value": "rfq",
          "label": "询价"
        },
        {
          "value": "purchase_order",
          "label": "采购订单"
        },
        {
          "value": "bin",
          "label": "库存明细"
        }
      ]
    },
    "dimension": {
      "question": "按哪个对象口径看？",
      "options": [
        {
          "value": "supplier",
          "label": "供应商"
        },
        {
          "value": "warehouse",
          "label": "仓库"
        },
        {
          "value": "sku",
          "label": "物料"
        }
      ]
    },
    "time_window": {
      "question": "看哪个时间窗？",
