{
  "description": "R07 L08 演示补丁：只改一条验收标准的 Then、追加一条跳过分支验收、补充埋点，其余字段一字不动。",
  "target": "examples/prd.json",
  "operations": [
    {
      "op": "test",
      "path": "/metrics/north_star",
      "value": "7 日激活率"
    },
    {
      "op": "replace",
      "path": "/acceptance_criteria/0/then",
      "value": "出现分步引导，并在 24 小时内完成首项目创建"
    },
    {
      "op": "add",
      "path": "/acceptance_criteria/-",
      "value": {
        "given": "用户在引导第 2 步点击跳过",
        "when": "30 天后再次进入工作台",
        "then": "底部保留引导入口且不计入放弃率"
      }
    },
    {
      "op": "add",
      "path": "/telemetry",
      "value": [
        "guide_step_view",
        "guide_step_complete",
        "guide_skip_click"
      ]
    }
  ]
}
