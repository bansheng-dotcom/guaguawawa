{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "R14-Commerce-Audit",
          "semanticVersion": "12.0.0",
          "informationUri": "https://github.com/wawa-guagua/r14-wajiaoyi-commerce",
          "rules": [
            {
              "id": "COMM001",
              "name": "IdempotencyMissing",
              "shortDescription": {
                "text": "缺失交易幂等键 (GATE-01)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "COMM002",
              "name": "BalanceImbalance",
              "shortDescription": {
                "text": "财务勾稽平衡破损 (GATE-02)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "COMM003",
              "name": "RefundRatioExceeded",
              "shortDescription": {
                "text": "退款比例超过上限 (GATE-06)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "COMM004",
              "name": "NegativeUsageDetected",
              "shortDescription": {
                "text": "计量用量出现非法负数 (GATE-07)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": []
    }
  ]
}