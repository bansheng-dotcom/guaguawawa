  "terms": [
    {
      "term": "refund_rate",
      "meaning": "退款率增幅 = 本期退款率 − 基期退款率（单位 %，目标 ≤ 1.0，越界判定：> 1.5 暂停活动）",
      "source": "configs/ 阈值外置定义"
    },
    {
      "term": "pay_success",
      "meaning": "支付成功率 = 支付成功单 / 下单单（单位 %，目标 ≥ 98，越界判定：< 95 回滚支付配置）",
      "source": "configs/ 阈值外置定义"
    },
    {
      "term": "aov",
      "meaning": "客单价 = GMV / 订单数（单位 元，目标 环比不降 3%，越界判定：降 > 3% 强制回滚）",
      "source": "configs/ 阈值外置定义"
    },
    {
      "term": "G1",
      "meaning": "门禁：到手价低于成本线 → BLOCKER，处置 立即下架",
      "source": "semantic_layer.gates"
    },
    {
      "term": "G2",
      "meaning": "门禁：退款率增幅 > 1.5% → BLOCKER，处置 暂停活动并排查",
      "source": "semantic_layer.gates"
    },
    {
      "term": "G3",
      "meaning": "门禁：退款额度 > 原支付金额 → BLOCKER，处置 拒绝，退回补正",
      "source": "semantic_layer.gates"
    }
  ],
