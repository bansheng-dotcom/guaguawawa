{
  "_note": "workflow-reliability 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "dlq_retry": {
      "name": "死信重试次数",
      "formula": "同一消息重试计数",
      "unit": "次",
      "target": "≤ 1",
      "alert": "> 3 报警停工单"
    },
    "dangling": {
      "name": "悬空连线数",
      "formula": "指向不存在节点的边数",
      "unit": "条",
      "target": "0",
      "alert": "≥ 1 禁止发布"
    }
  },
  "gates": {
    "G1": {
      "when": "出现悬空连线或未接失败分支",
      "verdict": "BLOCKER",
      "action": "禁止发布"
    },
    "G2": {
      "when": "凭据明文出现在流程定义",
      "verdict": "BLOCKER",
      "action": "立即轮换密钥"
    },
    "G3": {
      "when": "涉及资金/删除无人工审批",
      "verdict": "BLOCKER",
      "action": "补审批门"
    }
  }
}
