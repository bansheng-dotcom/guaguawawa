# Python
__pycache__/
*.pyc

# baselines：只留黄金语料与作者样例，产出目录/临时脚本不入库
baselines/*_out*/
baselines/_hbge*/
baselines/_shadow_test/
baselines/_ir_*/
baselines/_treat_compare.py
baselines/_hbge_diff.py
baselines/_figs/
baselines/_shadow_flow/
baselines/_decord_demo/
baselines/_dod_demo/

# 测试 / 运行产物
.pytest_cache/
workspace/
pipelines/out/
*/_test_*/
*/tests/workspace/

# 项目资产必须在团外（见 core/paths.py）；这几条是防误提交的兜底
# 注意：gitignore 只防新增，已跟踪文件仍会被提交 —— 由 scripts/check_project_boundary.py 兜底
projects/
briefs/
cards/
claims/
report/
claims_*.json

# P4 代码包：core/ 下同名目录是代码，不是项目资产（不这样写，整包会不进库）
# 只放行 .py，避免把 __pycache__ 一起放进来
!core/claims/
!core/claims/**/*.py
!core/cards/
!core/cards/**/*.py
!core/report/
!core/report/**/*.py

# 头像拼版预览（avatars/ 才是唯一源）
头像预览联系表.png

# handover baseline（PR0）：记录冻结时的提交，不入库
.baseline_commit
