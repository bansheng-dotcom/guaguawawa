{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "R08-WaJianCheng-QualityEngine",
          "version": "1.0.0",
          "rules": [
            {
              "id": "R08-G01",
              "name": "A11yContrastGate",
              "shortDescription": {
                "text": "文本与背景对比度需满足 WCAG AA 级标准 (>= 4.5:1)"
              }
            },
            {
              "id": "R08-G02",
              "name": "FormEndpointSecurityGate",
              "shortDescription": {
                "text": "表单提交端点必须采用 HTTPS 协议加密传输"
              }
            }
          ]
        }
      },
      "results": []
    }
  ]
}