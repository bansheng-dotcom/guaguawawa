  "l2_prompt_blocks": [
    {
      "name": "切片边界",
      "template": "只交付一条可跑通的最小主路径（目标平台：{platform}），范围外需求一律写入「不做清单」，不得扩写成全家桶。"
    },
    {
      "name": "五门禁自检",
      "template": "交付前逐项核对：假设明确、范围最小、可本地运行、有验收脚本、有回滚/关闭开关；缺一项即视为未完成。"
    },
    {
      "name": "禁用词与反例",
      "template": "禁止「赋能、闭环、抓手、生态化」等空话；禁止只给目录树不给可执行文件，禁止把 TODO 当交付。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "MVP 假设",
      "范围与不做清单",
      "运行方式",
      "验收步骤"
    ]
