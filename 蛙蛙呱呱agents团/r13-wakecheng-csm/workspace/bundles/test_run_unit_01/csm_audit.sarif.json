{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CSM-Health-Auditor",
          "semanticVersion": "11.0.0",
          "rules": [
            {
              "id": "CSM001",
              "name": "FirstResponseSlaBreached",
              "shortDescription": {
                "text": "全渠道客服首响超时 (GATE-01)"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CSM002",
              "name": "TicketReopenRateExceeded",
              "shortDescription": {
                "text": "工单重开率超出警戒线 0.15 (GATE-03)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CSM003",
              "name": "RenewalDualGateFailed",
              "shortDescription": {
                "text": "续约双门槛不达标 (GATE-06)"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CSM001",
          "level": "warning",
          "message": {
            "text": "首响轻微波动"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "client_profile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}