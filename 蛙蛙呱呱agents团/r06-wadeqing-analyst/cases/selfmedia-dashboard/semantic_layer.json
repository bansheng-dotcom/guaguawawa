{
  "grain": {
    "default": "platform-day",
    "supported": ["platform-day", "platform"]
  },
  "fields": {
    "platform": {
      "role": "dimension",
      "business_name": "平台",
      "unit": "类别",
      "meaning": "抖音/微信/小红书/知乎/B站 等",
      "quality_rule": "必须在平台白名单内，未知平台入「其他」并告警"
    },
    "date": {
      "role": "dimension",
      "business_name": "日期",
      "unit": "date",
      "meaning": "数据快照日期",
      "quality_rule": "用于新鲜度判定：距今天数 > stale_days 判过期"
    },
    "total_followers": {
      "role": "metric",
      "business_name": "总粉丝",
      "unit": "人",
      "meaning": "最新快照粉丝数",
      "quality_rule": "取最新快照，不累加"
    },
    "new_followers": {
      "role": "metric",
      "business_name": "新增粉丝",
      "unit": "人",
      "meaning": "区间内净增",
      "quality_rule": "按日期范围求和；口径以平台优先来源为准"
    },
    "net_revenue": {
      "role": "metric",
      "business_name": "净收入",
      "unit": "元",
      "meaning": "gross_revenue - refund_amount",
      "quality_rule": "净额 = 毛收入 - 退款；负数需告警"
    },
    "content_count": {
      "role": "metric",
      "business_name": "内容条数",
      "unit": "条",
      "meaning": "发布内容数",
      "quality_rule": "非负整数"
    }
  },
  "business_terms": {
    "新鲜": "距今天数 ≤ fresh_days",
    "过期": "距今天数 > stale_days",
    "HHI": "收入集中度 = 各平台份额平方和，高 HHI 提示单平台依赖"
  },
  "analysis_boundaries": {
    "do": ["先做新鲜度校验", "净额口径统一", "报告 HHI 集中度"],
    "dont": ["过期数据进正常日报", "小红书内容归因涨粉当全局净增", "收入不扣退款"]
  }
}