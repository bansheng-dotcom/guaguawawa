{
  "case_id": "fullstack-delivery",
  "display_name": "全栈交付闭环（四步）",
  "description": "从技术规格出发，建数据库 Schema，接端到端功能切片，最后做可逆迁移。演示工程链路的边界可判、契约可验、迁移可回滚。",
  "default_question": "给结算功能做一份可交付的全栈工程切片，从规格到迁移全程可验证。",
  "default_context": {
    "feature": "结算 billing",
    "stack": "Next.js + PostgreSQL"
  },
  "steps": [
    {
      "skill": "spec",
      "action": "spec",
      "input": "inputs/spec.json",
      "expect": {"ok": true, "module_count": 2, "boundary_ok": true}
    },
    {
      "skill": "data_api",
      "action": "schema",
      "input": "inputs/schema.json",
      "expect": {"ok": true, "table_count": 2, "column_count": 4}
    },
    {
      "skill": "fullstack",
      "action": "feature",
      "input": "inputs/feature.json",
      "expect": {"ok": true, "e2e_coverage": 1.0}
    },
    {
      "skill": "ops",
      "action": "migration",
      "input": "inputs/migration.json",
      "expect": {"ok": true, "rollback_steps": 2, "irreversible_found": []}
    }
  ]
}
