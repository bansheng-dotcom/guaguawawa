  "l2_prompt_blocks": [
    {
      "name": "工程约束",
      "template": "技术栈：{stack}；数据库：{store}；规模：{scale}。先用最小可运行实现打通，再谈扩展，禁止提前抽象。"
    },
    {
      "name": "可验证交付",
      "template": "每个交付必须附：可执行命令、预期输出、失败注入方式；没有验证手段的代码视为未完成。"
    },
    {
      "name": "禁用词与反例",
      "template": "禁止「赋能、闭环、抓手、造轮子式重构」；禁止只给伪代码、只给 TODO、只给架构图不落地。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "接口/模块边界",
      "实现步骤",
      "验证命令",
      "回滚方式"
    ]
  }
