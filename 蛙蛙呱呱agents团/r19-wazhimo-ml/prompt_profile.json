  "l2_prompt_blocks": [
    {
      "name": "评估口径",
      "template": "评估对象：{topic}；目标阶段：{stage}。必须写清数据集版本、评分器版本、样本量与置信区间，禁止只报单一均值。"
    },
    {
      "name": "可复现自检",
      "template": "每个结论附可复跑命令与随机种子；缺少复现路径的评测结果一律降级为「参考值」。"
    },
    {
      "name": "禁用词与反例",
      "template": "禁止「赋能、闭环、抓手、大幅超越 SOTA」等空话；禁止用未标注数据当评估集，禁止只挑好样本汇报。"
    }
  ],
  "output_contract": {
    "format": "md",
    "must_include": [
      "评估目标",
      "数据集与评分器版本",
      "指标与结论",
      "风险与回滚"
