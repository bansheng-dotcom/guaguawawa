{
  "_note": "蛙智模（ML / 算法模型）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r19",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "ML / 算法模型",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "diversity_drop",
      "name": "推荐流多样性降幅",
      "formula": "(基期类目熵 − 本期) / 基期",
      "unit": "%",
      "target": "≤ 5",
      "alert": "> 10 重新加权召回"
    },
    {
      "id": "gain",
      "name": "实验组转化增益",
      "formula": "实验组 CVR − 对照组 CVR",
      "unit": "%",
      "target": "> 0 且显著",
      "alert": "显著负向即回滚"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "多样性降幅 > 10%",
      "verdict": "BLOCKER",
      "action": "重新加权召回，不得推全"
    },
    {
      "id": "G2",
      "when": "实验参数未记录完整",
      "verdict": "BLOCKER",
      "action": "实验作废"
    },
    {
      "id": "G3",
      "when": "对照组出现显著负向",
      "verdict": "BLOCKER",
      "action": "立即回滚"
    }
  ],
  "guardrails": [
    {
      "dim": "推荐流多样性降幅",
      "metric": "推荐流多样性降幅",
      "base": "≤ 5",
      "threshold": "> 10 重新加权召回"
    },
    {
      "dim": "实验组转化增益",
      "metric": "实验组转化增益",
      "base": "> 0 且显著",
      "threshold": "显著负向即回滚"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "model-gain"
}
