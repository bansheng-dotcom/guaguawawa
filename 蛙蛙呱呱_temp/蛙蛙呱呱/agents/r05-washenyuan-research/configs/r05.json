{
  "_note": "蛙深远（Research / 商业研究）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r05",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Research / 商业研究",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "ci_width",
      "name": "市场空间置信区间宽度",
      "formula": "(上限 − 下限) / 中值",
      "unit": "%",
      "target": "≤ 40%",
      "alert": "> 40% 只出方向性结论"
    },
    {
      "id": "source_coverage",
      "name": "结论带来源比例",
      "formula": "有来源结论数 / 结论总数",
      "unit": "%",
      "target": "100%",
      "alert": "< 100% 作废"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "双口径互证偏离 > 40%",
      "verdict": "WARN",
      "action": "降级为方向性结论，不出具体数字"
    },
    {
      "id": "G2",
      "when": "竞品覆盖 < 3 家",
      "verdict": "BLOCKER",
      "action": "不得出竞品结论"
    },
    {
      "id": "G3",
      "when": "结论无来源",
      "verdict": "BLOCKER",
      "action": "作废重写"
    }
  ],
  "guardrails": [
    {
      "dim": "市场空间置信区间宽度",
      "metric": "市场空间置信区间宽度",
      "base": "≤ 40%",
      "threshold": "> 40% 只出方向性结论"
    },
    {
      "dim": "结论带来源比例",
      "metric": "结论带来源比例",
      "base": "100%",
      "threshold": "< 100% 作废"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "market-sizing"
}
