{
  "schema_version": "r06l-experiment-profiles-1.0",
  "defaults": {
    "alpha": 0.05,
    "power": 0.80,
    "impact_min_pct": 3.0,
    "default_mde_for_demo": 0.01,
    "allocation": {"control": 0.50, "treatment": 0.50},
    "min_runtime_days": 14,
    "srm_chi2_critical": 3.841,
    "decision": {
      "require_srm_pass": true,
      "require_power_sample": true,
      "require_significance": true,
      "require_positive_lift": true,
      "require_impact_min": true
    }
  },
  "profiles": {
    "ecommerce_conversion": {
      "display_name": "电商下单转化",
      "use_for": ["商品详情页", "主图", "CTA", "购物链路"],
      "primary_metric": "conversion_rate",
      "analysis_method": "binary_rate",
      "baseline": {"source": "最近28天同口径历史", "fallback": 0.05, "min": 0.005, "max": 0.60, "fallback_is_planning_only": true},
      "mde": {"mode": "relative", "default": 0.10, "min": 0.05, "max": 0.25, "note": "低基线场景优先用相对提升；同时记录绝对百分点"},
      "alpha": 0.05,
      "power": 0.80,
      "impact_min_pct": 3.0,
      "guardrails": ["aov_buyer", "refund_rate", "negative_review_rate", "fulfillment_time"],
      "minimum_runtime_days": 14
    },
    "ecommerce_revenue": {
      "display_name": "电商每用户营收",
      "use_for": ["价格", "优惠券", "套餐", "客单价"],
      "primary_metric": "revenue_per_user",
      "analysis_method": "continuous_mean",
      "baseline": {"source": "最近28天同口径历史均值", "fallback": null, "required": true},
      "mde": {"mode": "relative", "default": 0.05, "min": 0.03, "max": 0.15},
      "alpha": 0.05,
      "power": 0.80,
      "impact_min_pct": 3.0,
      "guardrails": ["conversion_rate", "refund_rate", "gross_margin"],
      "minimum_runtime_days": 14
    },
    "lead_generation": {
      "display_name": "线索/表单提交",
      "use_for": ["落地页", "表单", "咨询按钮", "预约"],
      "primary_metric": "lead_conversion_rate",
      "analysis_method": "binary_rate",
      "baseline": {"source": "最近28天同口径历史", "fallback": 0.10, "min": 0.01, "max": 0.80},
      "mde": {"mode": "relative", "default": 0.10, "min": 0.08, "max": 0.25},
      "alpha": 0.05,
      "power": 0.80,
      "impact_min_pct": 5.0,
      "guardrails": ["qualified_lead_rate", "cost_per_lead", "spam_rate"],
      "minimum_runtime_days": 14
    },
    "content_engagement": {
      "display_name": "内容互动/播放",
      "use_for": ["抖音视频素材", "标题", "封面", "投流创意"],
      "primary_metric": "engagement_rate",
      "analysis_method": "binary_rate",
      "baseline": {"source": "最近14天同账号同流量类型", "fallback": 0.03, "min": 0.005, "max": 0.50},
      "mde": {"mode": "relative", "default": 0.15, "min": 0.10, "max": 0.40},
      "alpha": 0.05,
      "power": 0.80,
      "impact_min_pct": 8.0,
      "guardrails": ["negative_feedback_rate", "follow_rate", "conversion_rate"],
      "minimum_runtime_days": 7
    },
    "retention": {
      "display_name": "留存/复购",
      "use_for": ["会员权益", "召回", "复购触达", "订阅"],
      "primary_metric": "retention_rate",
      "analysis_method": "binary_rate",
      "baseline": {"source": "最近8周同 cohort", "fallback": 0.20, "min": 0.02, "max": 0.90},
      "mde": {"mode": "relative", "default": 0.08, "min": 0.05, "max": 0.20},
      "alpha": 0.05,
      "power": 0.80,
      "impact_min_pct": 5.0,
      "guardrails": ["unsubscribe_rate", "complaint_rate", "discount_cost_per_retained_user"],
      "minimum_runtime_days": 28
    },
    "latency_error": {
      "display_name": "性能/错误率",
      "use_for": ["页面加载", "接口", "支付链路", "技术发布"],
      "primary_metric": "continuous_or_rate",
      "analysis_method": "continuous_or_rate",
      "baseline": {"source": "最近7天同峰值时段", "fallback": null, "required": true},
      "mde": {"mode": "absolute", "default": null, "note": "按业务可接受毫秒数或错误百分点设置；不套用转化率公式"},
      "alpha": 0.01,
      "power": 0.90,
      "impact_min_pct": 0.0,
      "guardrails": ["conversion_rate", "crash_rate", "availability"],
      "minimum_runtime_days": 7
    }
  },
  "parameter_policy": {
    "baseline": "必须来自同口径历史或预实验；fallback 仅用于方案模拟，不可直接用于生产决策",
    "mde": "优先从利润/成本/容量反推最低值得检测效果；不要为了省样本把 MDE 设得过大",
    "alpha": "常规产品实验 0.05；高风险支付/技术变更可用 0.01",
    "power": "常规 0.80；高成本或高风险决策 0.90",
    "impact_min_pct": "统计显著仍需达到业务最小收益；应结合毛利、流量和执行成本设定",
    "guardrails": "至少配置一个不应恶化的指标；护栏恶化时不得仅凭主指标显著而放量"
  }
}
