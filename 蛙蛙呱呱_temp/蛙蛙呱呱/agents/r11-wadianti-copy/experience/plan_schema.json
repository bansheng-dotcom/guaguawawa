{
  "_comment": "内容计划（Content Plan）契约：每次内容请求必须先输出符合此格式的计划；harness 做确定性校验（r11 内容口径，区别于 r10 视觉口径）。",
  "required_fields": [
    "round",
    "content_step",
    "target_artifact",
    "stance",
    "deliverables",
    "acceptance_criteria",
    "stop_condition"
  ],
  "content_step_enum": [
    "topic",
    "seo",
    "hook",
    "copy",
    "voice",
    "pr",
    "platform",
    "localize"
  ],
  "deliverables_required": [
    "artifact_type",
    "file_path"
  ],
  "acceptance_criteria_required": [
    "min_gates",
    "all_gates_pass"
  ],
  "stop_condition_required": [
    "if_gate_fails",
    "reason"
  ]
}
