{
  "_note": "蛙点题（Copy / 文案操盘）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r11",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Copy / 文案操盘",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "bounce",
      "name": "进店后首跳跳失率",
      "formula": "首跳离开会话 / 进店会话",
      "unit": "%",
      "target": "≤ 8%",
      "alert": "> 15% 修正标题歧义"
    },
    {
      "id": "forbidden",
      "name": "违禁词命中数",
      "formula": "命中平台违禁词表次数",
      "unit": "处",
      "target": "0",
      "alert": "≥ 1 禁止发布"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "违禁词命中",
      "verdict": "BLOCKER",
      "action": "禁止发布，改写"
    },
    {
      "id": "G2",
      "when": "标题承诺与正文不符",
      "verdict": "BLOCKER",
      "action": "判为标题党，退回重写"
    },
    {
      "id": "G3",
      "when": "字数超出平台区间",
      "verdict": "WARN",
      "action": "按平台重剪"
    }
  ],
  "guardrails": [
    {
      "dim": "进店后首跳跳失率",
      "metric": "进店后首跳跳失率",
      "base": "≤ 8%",
      "threshold": "> 15% 修正标题歧义"
    },
    {
      "dim": "违禁词命中数",
      "metric": "违禁词命中数",
      "base": "0",
      "threshold": "≥ 1 禁止发布"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "headline-test"
}
