{
  "_note": "channel-attribution 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "fake_ratio": {
      "name": "伪泛粉占比",
      "formula": "无效互动用户 / 新增用户",
      "unit": "%",
      "target": "≤ 20%",
      "alert": "> 40% 立即调整定向"
    },
    "roi": {
      "name": "渠道 ROI",
      "formula": "渠道毛利 / 渠道花费",
      "unit": "×",
      "target": "≥ 2",
      "alert": "< 1.5 连续 3 天停投"
    },
    "d1": {
      "name": "次留率",
      "formula": "次日回访用户 / 新增用户",
      "unit": "%",
      "target": "≥ 25",
      "alert": "< 15 判定渠道无效"
    }
  },
  "gates": {
    "G1": {
      "when": "伪泛粉 > 40%",
      "verdict": "BLOCKER",
      "action": "停机复审定向"
    },
    "G2": {
      "when": "归因窗口不一致",
      "verdict": "WARN",
      "action": "统一归因口径后再比较"
    },
    "G3": {
      "when": "单位经济为负仍加投",
      "verdict": "BLOCKER",
      "action": "立即停投"
    }
  }
}
