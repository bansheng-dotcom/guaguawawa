{
  "_note": "蛙客成（CSM / 客户成功）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r13",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "CSM / 客户成功",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "ndr",
      "name": "月度活跃净留存",
      "formula": "(期初 MRR + 扩张 − 流失 − 降级) / 期初 MRR",
      "unit": "%",
      "target": "≥ 100",
      "alert": "< 95 启动挽回"
    },
    {
      "id": "health",
      "name": "平均健康分",
      "formula": "加权（使用频次/工单/续约意愿）",
      "unit": "分",
      "target": "≥ 70",
      "alert": "< 60 全量排查"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "NDR < 95%",
      "verdict": "BLOCKER",
      "action": "启动专项挽回并上报 R01"
    },
    {
      "id": "G2",
      "when": "P1 工单首响 > 8h",
      "verdict": "WARN",
      "action": "升级值班，补 SLA"
    },
    {
      "id": "G3",
      "when": "续约前 30 天无触达记录",
      "verdict": "WARN",
      "action": "强制排期触达"
    }
  ],
  "guardrails": [
    {
      "dim": "月度活跃净留存",
      "metric": "月度活跃净留存",
      "base": "≥ 100",
      "threshold": "< 95 启动挽回"
    },
    {
      "dim": "平均健康分",
      "metric": "平均健康分",
      "base": "≥ 70",
      "threshold": "< 60 全量排查"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "churn-warning"
}
