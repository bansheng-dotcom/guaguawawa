{
  "_note": "R08 蛙建成·产品实现官的全局阈值，harness 与各技能统一引用（T9 外置，改口径不改代码）。键名与 skills/_common._DEFAULT_THRESHOLDS 严格一致。",
  "slice": {
    "artifact_types": ["cli", "tool", "web", "landing", "saas", "email", "app"],
    "slices_min": 1
  },
  "mvp": {
    "gates": ["assumption", "mvp", "experiment", "criteria", "handoff"],
    "risk_types": ["value", "usability", "viability", "feasibility",
                   "ethics", "gtm", "strategy", "team"],
    "experiment_min": 1
  },
  "scaffold": {
    "stack_types": ["nextjs", "rails", "mcp", "python-flask", "vite-html",
                    "node-express"],
    "auth_types": ["none", "api-key", "oauth", "session"],
    "entry_markers": ["main", "index", "app"]
  },
  "landing": {
    "keys": ["goal", "headline", "subhead", "proof_points", "form",
             "button", "faq", "post_submit"],
    "proof_min": 3,
    "tech_constraints": ["single_file_index_html", "no_js_library",
                         "form_deliverable", "mobile_first", "button_single_accent"]
  },
  "saas": {
    "pages_min": 2,
    "auth_types": ["session", "jwt", "oauth", "email-link", "none"]
  },
  "prototype": {
    "structure_keys": ["main", "app", "core", "features", "shared_widgets", "router"],
    "feature_layers": ["data", "domain", "presentation", "providers"],
    "platforms": ["android", "ios", "web", "desktop"]
  },
  "design": {
    "token_types": ["color", "typography", "spacing"],
    "scale_types": ["font_size", "spacing", "radius", "shadow"]
  },
  "qa": {
    "required_checks": ["build", "typecheck", "screenshot", "design_qa", "a11y"],
    "status_types": ["pass", "fail", "block"],
    "a11y_min": 3
  },
  "review": {
    "vague_words": ["待定", "TODO", "TBD", "占位", "随便", "大概",
                    "稍后补充", "后续完善", "以后再写", "占位符"],
    "scope_terms": ["生产级", "高可用", "灾备", "监控告警", "CI/CD", "CI",
                    "CDN", "多机房", "横向扩容"],
    "concrete_keys": ["file_path", "run_command", "run_commands", "artifact",
                      "artifacts", "tree", "files", "screens", "templates",
                      "checks", "ok"],
    "conclusion_keys": ["summary", "note", "next", "description", "text",
                        "purpose", "hypothesis", "statement", "goal", "delivery",
                        "trigger", "content", "body", "label", "max_objection",
                        "headline", "subhead", "subject", "title", "name", "value"],
    "handoff_keys": ["handoff", "owner"],
    "verdict_enum": ["PASS", "FAIL"]
  }
}
