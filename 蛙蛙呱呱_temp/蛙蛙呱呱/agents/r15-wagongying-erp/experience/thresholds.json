    "so_billing_status": ["Not Billed", "Fully Billed", "Partly Billed", "Closed"],
    "so_required": ["customer", "items"],
    "so_item_required": ["item_code", "qty", "rate"],
    "delivery_status": ["Draft", "To Bill", "Partially Billed", "Completed", "Return"],
    "delivery_required": ["customer", "items"],
    "max_so_lines": 200,
    "over_delivery_tolerance": 0.0
  },
  "production": {
    "mr_status": ["Draft", "Submitted", "Stopped", "Cancelled", "Pending", "Partially Ordered", "Partially Received", "Ordered", "Issued", "Transferred", "Received"],
