    "conclusion_keys": ["summary", "note", "next", "description", "conclusion", "recommendation", "reason", "narrative", "insight"],
    "evidence_keys": ["supplier_count", "po_count", "receipt_count", "item_count", "bin_count", "stock_value", "sales_order_count", "delivery_count", "bom_count", "material_request_count", "invoice_count", "payment_count", "total_amount", "total_qty", "line_item_count", "overlap_count", "matrix_count"]
