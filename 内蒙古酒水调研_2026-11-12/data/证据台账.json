  "conclusions": [
    {"id": "C01", "text": "内蒙古酒水总盘154亿元，白酒95亿占61.7%", "sources": ["S01", "S04", "S13", "S14", "S27", "S28", "S30"]},
    {"id": "C02", "text": "人均酒水消费649元/年，占人均食品烟酒支出7.8%", "sources": ["S01", "S13"]},
    {"id": "C03", "text": "地产白酒38.1亿元，份额40.1%；外来名酒56.9亿元，份额59.9%", "sources": ["S12", "S13", "S19", "S21", "S22"]},
    {"id": "C04", "text": "河套酒业13.9亿元，占地产酒36.5%、全区白酒14.6%", "sources": ["S13", "S15", "S17"]},
    {"id": "C05", "text": "价格带两头强、中间塌：千元带名酒12%，300-800元23%，100-300元35%，百元以下30%", "sources": ["S12", "S14"]},
    {"id": "C06", "text": "全国白酒产量354.9万千升(-12.1%)，连续9年下滑，较2016年峰值-73.9%", "sources": ["S03"]},
    {"id": "C07", "text": "内蒙古啤酒62.28万千升(-3%)，抗跌性优于白酒", "sources": ["S04"]},
    {"id": "C08", "text": "燕京系在内蒙古啤酒份额约59%（雪鹿30万吨+金川7万吨，合计37万吨）", "sources": ["S23", "S24", "S25", "S04"]},
    {"id": "C09", "text": "包头啤酒产量9.996万千升、白酒0.411万千升，酒类生产高度集中于少数盟市", "sources": ["S05", "S06", "S07", "S08", "S09", "S10"]},
    {"id": "C10", "text": "禁酒令使渠道利润下降30%-70%，100-300元盒装酒受冲击最大", "sources": ["S32", "S33"]},
    {"id": "C11", "text": "行业存货周转900天，20家上市酒企存货1706.86亿元(+11.32%)", "sources": ["S34"]},
    {"id": "C12", "text": "盒装酒128元：厂家净利率18.6%，渠道拿20.3%，终端拿31.3%", "sources": ["S31", "S40"]},
    {"id": "C13", "text": "25元纯粮光瓶酒厂家净利率-5.1%，不具备利润能力", "sources": ["S31", "S36"]},
    {"id": "C14", "text": "啤酒回收瓶体系每瓶省0.5元，30万吨规模年省3亿元", "sources": ["S23", "S24", "S37"]},
    {"id": "C15", "text": "白酒设计产能90万吨、2025年产量约4.8万吨，产能利用率5.3%", "sources": ["S11", "S13", "S15", "S19", "S21"]},
    {"id": "C16", "text": "高粱到厂价：赤峰2700-2740元/吨、通辽2640、兴安盟2660，本地化率70-85%", "sources": ["S36"]},
    {"id": "C17", "text": "包材占出厂价12-15%，玻璃瓶2.1-3.2元/只，主要来自山东/江苏，运费使成本上升4-6%", "sources": ["S37", "S40", "S38"]},
    {"id": "C18", "text": "呼市→北京重货183-207元/吨，折0.26-0.29元/瓶", "sources": ["S38"]},
    {"id": "C19", "text": "传统经销商占销售额76.4%，线上直销6.0%，抖音占线上43.2%", "sources": ["S34", "S41"]},
    {"id": "C20", "text": "内蒙古酒业商会会员976家，规上酒类企业60多家", "sources": ["S39", "S12"]},
    {"id": "C21", "text": "乌海葡萄酒年产值2亿元、加工能力2万吨，自治区同行业第一", "sources": ["S27"]},
    {"id": "C22", "text": "锡林郭勒马奶产业近1亿元，阿巴嘎旗鲜马奶1000吨/产值2000万元", "sources": ["S28", "S29"]},
    {"id": "C23", "text": "鸿茅药业2023年营收1.97亿元，保健酒为区域特色小众品类", "sources": ["S30"]},
    {"id": "C24", "text": "内蒙古2025年游客3.0亿人次、花费4536.8亿元(+9.6%)，酒旅融合是增量渠道", "sources": ["S01"]}
  ]
}
