{
  "_note": "artifact-reject 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "l2_completeness": {
      "name": "L2 实质性证据完备度",
      "formula": "已提供实质证据条目 / 应提供条目",
      "unit": "%",
      "target": "100%",
      "alert": "< 100% 即刻驳回"
    },
    "stub_hits": {
      "name": "占位实现命中数",
      "formula": "stub/TODO/NotImplemented 出现次数",
      "unit": "处",
      "target": "0",
      "alert": "≥ 1 判不通过"
    }
  },
  "gates": {
    "G1": {
      "when": "L1 存在性通过但 L2 实质性为空",
      "verdict": "BLOCKER",
      "action": "判 REJECT，退回补证"
    },
    "G2": {
      "when": "发现 stub/TODO 占位实现",
      "verdict": "BLOCKER",
      "action": "判不通过，不得进入下游"
    },
    "G3": {
      "when": "结论无来源引用",
      "verdict": "BLOCKER",
      "action": "驳回并要求标注来源"
    }
  }
}
