{
  "_note": "「备份存在但没人演练过恢复」案例级阈值覆盖。仅覆盖本案例与全局不同的口径；未出现键沿用 experience/thresholds.json 全局值。",
  "backup": {
    "min_snapshots": 1,
    "retention_policies": ["keep_last", "keep_hourly", "keep_daily", "keep_weekly", "keep_monthly", "keep_yearly"]
