{
  "_note": "蛙交易（Commerce / 电商操盘）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r14",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "Commerce / 电商操盘",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "refund_rate",
      "name": "退款率增幅",
      "formula": "本期退款率 − 基期退款率",
      "unit": "%",
      "target": "≤ 1.0",
      "alert": "> 1.5 暂停活动"
    },
    {
      "id": "pay_success",
      "name": "支付成功率",
      "formula": "支付成功单 / 下单单",
      "unit": "%",
      "target": "≥ 98",
      "alert": "< 95 回滚支付配置"
    },
    {
      "id": "aov",
      "name": "客单价",
      "formula": "GMV / 订单数",
      "unit": "元",
      "target": "环比不降 3%",
      "alert": "降 > 3% 强制回滚"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "到手价低于成本线",
      "verdict": "BLOCKER",
      "action": "立即下架"
    },
    {
      "id": "G2",
      "when": "退款率增幅 > 1.5%",
      "verdict": "BLOCKER",
      "action": "暂停活动并排查"
    },
    {
      "id": "G3",
      "when": "退款额度 > 原支付金额",
      "verdict": "BLOCKER",
      "action": "拒绝，退回补正"
    }
  ],
  "guardrails": [
    {
      "dim": "退款率增幅",
      "metric": "退款率增幅",
      "base": "≤ 1.0",
      "threshold": "> 1.5 暂停活动"
    },
    {
      "dim": "支付成功率",
      "metric": "支付成功率",
      "base": "≥ 98",
      "threshold": "< 95 回滚支付配置"
    },
    {
      "dim": "客单价",
      "metric": "客单价",
      "base": "环比不降 3%",
      "threshold": "降 > 3% 强制回滚"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "funnel-pricing"
}
