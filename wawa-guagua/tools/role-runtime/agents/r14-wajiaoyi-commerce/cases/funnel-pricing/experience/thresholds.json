{
  "_note": "funnel-pricing 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "refund_rate": {
      "name": "退款率增幅",
      "formula": "本期退款率 − 基期退款率",
      "unit": "%",
      "target": "≤ 1.0",
      "alert": "> 1.5 暂停活动"
    },
    "pay_success": {
      "name": "支付成功率",
      "formula": "支付成功单 / 下单单",
      "unit": "%",
      "target": "≥ 98",
      "alert": "< 95 回滚支付配置"
    },
    "aov": {
      "name": "客单价",
      "formula": "GMV / 订单数",
      "unit": "元",
      "target": "环比不降 3%",
      "alert": "降 > 3% 强制回滚"
    }
  },
  "gates": {
    "G1": {
      "when": "到手价低于成本线",
      "verdict": "BLOCKER",
      "action": "立即下架"
    },
    "G2": {
      "when": "退款率增幅 > 1.5%",
      "verdict": "BLOCKER",
      "action": "暂停活动并排查"
    },
    "G3": {
      "when": "退款额度 > 原支付金额",
      "verdict": "BLOCKER",
      "action": "拒绝，退回补正"
    }
  }
}
