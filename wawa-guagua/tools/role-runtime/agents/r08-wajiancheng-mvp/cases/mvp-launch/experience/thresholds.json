{
  "_note": "mvp-launch 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "error_rate": {
      "name": "核心路径报错率",
      "formula": "报错会话 / 总会话",
      "unit": "%",
      "target": "≤ 0.1%",
      "alert": "> 0.5% 回滚"
    },
    "tti": {
      "name": "移动端首屏可交互时间",
      "formula": "Performance TTI 中位数",
      "unit": "s",
      "target": "≤ 2",
      "alert": "> 3 不得放量"
    }
  },
  "gates": {
    "G1": {
      "when": "核心路径报错率 > 0.5%",
      "verdict": "BLOCKER",
      "action": "回滚上一版本"
    },
    "G2": {
      "when": "功能点数 > 8",
      "verdict": "WARN",
      "action": "退回做减法"
    },
    "G3": {
      "when": "无可用回滚路径",
      "verdict": "BLOCKER",
      "action": "禁止上线"
    }
  }
}
