{
  "_note": "蛙建成（MVP / 敏捷交付）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r08",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "MVP / 敏捷交付",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "error_rate",
      "name": "核心路径报错率",
      "formula": "报错会话 / 总会话",
      "unit": "%",
      "target": "≤ 0.1%",
      "alert": "> 0.5% 回滚"
    },
    {
      "id": "tti",
      "name": "移动端首屏可交互时间",
      "formula": "Performance TTI 中位数",
      "unit": "s",
      "target": "≤ 2",
      "alert": "> 3 不得放量"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "核心路径报错率 > 0.5%",
      "verdict": "BLOCKER",
      "action": "回滚上一版本"
    },
    {
      "id": "G2",
      "when": "功能点数 > 8",
      "verdict": "WARN",
      "action": "退回做减法"
    },
    {
      "id": "G3",
      "when": "无可用回滚路径",
      "verdict": "BLOCKER",
      "action": "禁止上线"
    }
  ],
  "guardrails": [
    {
      "dim": "核心路径报错率",
      "metric": "核心路径报错率",
      "base": "≤ 0.1%",
      "threshold": "> 0.5% 回滚"
    },
    {
      "dim": "移动端首屏可交互时间",
      "metric": "移动端首屏可交互时间",
      "base": "≤ 2",
      "threshold": "> 3 不得放量"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "mvp-launch"
}
