{
  "_note": "market-sizing 案例级阈值：覆盖角色全局阈值，未列出的沿用以 experience/thresholds.json 为底。",
  "kpis": {
    "ci_width": {
      "name": "市场空间置信区间宽度",
      "formula": "(上限 − 下限) / 中值",
      "unit": "%",
      "target": "≤ 40%",
      "alert": "> 40% 只出方向性结论"
    },
    "source_coverage": {
      "name": "结论带来源比例",
      "formula": "有来源结论数 / 结论总数",
      "unit": "%",
      "target": "100%",
      "alert": "< 100% 作废"
    }
  },
  "gates": {
    "G1": {
      "when": "双口径互证偏离 > 40%",
      "verdict": "WARN",
      "action": "降级为方向性结论，不出具体数字"
    },
    "G2": {
      "when": "竞品覆盖 < 3 家",
      "verdict": "BLOCKER",
      "action": "不得出竞品结论"
    },
    "G3": {
      "when": "结论无来源",
      "verdict": "BLOCKER",
      "action": "作废重写"
    }
  }
}
