{
  "_note": "蛙守先（CFO / 财务风控）运行配置：阈值/维度/数据源外置，改规则不改代码（META-001 Stage 3）。",
  "role": "r03",
  "language": "zh",
  "enable_cache": true,
  "enable_vector": false,
  "report": {
    "engine": "agents/shared/report_engine.py",
    "generator": "agents/shared/report_generator.py",
    "doc_type": "CFO / 财务风控",
    "formats": [
      "html",
      "md"
    ],
    "sections": [
      "决策指令",
      "KPI 格栅",
      "三级归因",
      "护栏熔断",
      "灰度+下一步"
    ]
  },
  "kpis": [
    {
      "id": "runway",
      "name": "现金可支撑月数",
      "formula": "期末现金 / 月均净烧钱",
      "unit": "月",
      "target": "≥ 9",
      "alert": "< 4 启动止损预案"
    },
    {
      "id": "burn_multiple",
      "name": "烧钱倍数",
      "formula": "净烧钱 / 净新增 ARR",
      "unit": "×",
      "target": "≤ 2.0",
      "alert": "> 3.0 冻结扩张"
    },
    {
      "id": "cac_payback",
      "name": "CAC 回收期",
      "formula": "CAC / 月毛利/客户",
      "unit": "天",
      "target": "≤ 30",
      "alert": "> 45 暂停该渠道"
    }
  ],
  "gates": [
    {
      "id": "G1",
      "when": "跨表勾稽差异率 > 0.1%",
      "verdict": "BLOCKER",
      "action": "阻断结账，先查差异"
    },
    {
      "id": "G2",
      "when": "现金流安全月数 < 4",
      "verdict": "BLOCKER",
      "action": "启动止损预案并上报 R01"
    },
    {
      "id": "G3",
      "when": "报告出现未标注模拟的财务数字",
      "verdict": "BLOCKER",
      "action": "作废并重出，标注数据来源"
    }
  ],
  "guardrails": [
    {
      "dim": "现金可支撑月数",
      "metric": "现金可支撑月数",
      "base": "≥ 9",
      "threshold": "< 4 启动止损预案"
    },
    {
      "dim": "烧钱倍数",
      "metric": "烧钱倍数",
      "base": "≤ 2.0",
      "threshold": "> 3.0 冻结扩张"
    },
    {
      "dim": "CAC 回收期",
      "metric": "CAC 回收期",
      "base": "≤ 30",
      "threshold": "> 45 暂停该渠道"
    }
  ],
  "data_sources": [
    {
      "name": "examples/",
      "type": "local_json",
      "permission": "read_only",
      "note": "本轮真实执行所用输入，报告页脚记录 SHA256"
    }
  ],
  "case": "runway-crisis"
}
